{
    "name": "utranslate",
    "version": "1.1.0",
    "description": "A simple and lightweight Node.js translation utility designed to make translating text between languages easy and programmatic. Built in TypeScript.",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "repository": {
        "url": "https://github.com/IBO-Umbrel/utranslate"
    },
    "files": [
        "dist"
    ],
    "license": "MIT",
    "scripts": {
        "build:esm": "tsc -p tsconfig.esm.json",
        "build:cjs": "tsc -p tsconfig.cjs.json",
        "build": "npm run build:esm && npm run build:cjs",
        "prepublishOnly": "pnpm run build"
    },
    "keywords": [
        "translate",
        "translation",
        "language",
        "translator",
        "nodejs",
        "typescript"
    ],
    "author": "",
    "packageManager": "pnpm@10.28.2",
    "dependencies": {
        "fs": "0.0.1-security"
    },
    "devDependencies": {
        "@types/node": "^25.1.0"
    }
}
