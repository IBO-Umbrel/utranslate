{
    "name": "utranslate",
    "version": "1.0.5",
    "description": "A simple and lightweight Node.js translation utility designed to make translating text between languages easy and programmatic. Built in TypeScript.",
    "main": "dist/index.js",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "repository": {
        "url": "https://github.com/IBO-Umbrel/utranslate"
    },
    "files": [
        "dist"
    ],
    "license": "MIT",
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "pnpm run build"
    },
    "keywords": [
        "translate",
        "translation",
        "language",
        "translator",
        "nodejs",
        "typescript"
    ],
    "author": "",
    "packageManager": "pnpm@10.28.2",
    "dependencies": {
        "fs": "0.0.1-security"
    },
    "devDependencies": {
        "@types/node": "^25.1.0"
    }
}
